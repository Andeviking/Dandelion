--- /dev/null
+++ b/dandelion_snapshot.cpp
@@ -0,0 +1,485 @@
+// Export a typed Bool/BV assertion DAG using the pinned cvc5 public API.
+#include <cvc5/cvc5.h>
+#include <cvc5/cvc5_parser.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <new>
+#include <set>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+using Index = std::uint32_t;
+using cvc5::Kind;
+using cvc5::Term;
+
+class Unsupported : public std::runtime_error {
+ public:
+  using std::runtime_error::runtime_error;
+};
+
+class Empty : public std::runtime_error {
+ public:
+  using std::runtime_error::runtime_error;
+};
+
+class TooLarge : public std::runtime_error {
+ public:
+  using std::runtime_error::runtime_error;
+};
+
+Index CheckedIndex(std::size_t value) {
+  if (value >= std::numeric_limits<Index>::max())
+    throw TooLarge("Snapshot exceeds the dense index space");
+  return static_cast<Index>(value);
+}
+
+double Seconds(Clock::duration elapsed) {
+  return std::chrono::duration<double>(elapsed).count();
+}
+
+const char* Factory(Kind kind) {
+  switch (kind) {
+    case Kind::CONSTANT:
+      return "kApply";
+    case Kind::CONST_BOOLEAN:
+      return "kBoolValue";
+    case Kind::CONST_BITVECTOR:
+      return "kBvValue";
+    case Kind::NOT:
+      return "kNot";
+    case Kind::AND:
+      return "kAnd";
+    case Kind::OR:
+      return "kOr";
+    case Kind::XOR:
+      return "kXor";
+    case Kind::IMPLIES:
+      return "kImplies";
+    case Kind::EQUAL:
+      return "kEqual";
+    case Kind::DISTINCT:
+      return "kDistinct";
+    case Kind::ITE:
+      return "kIte";
+    case Kind::BITVECTOR_NOT:
+      return "kBvNot";
+    case Kind::BITVECTOR_NEG:
+      return "kBvNeg";
+    case Kind::BITVECTOR_AND:
+      return "kBvAnd";
+    case Kind::BITVECTOR_OR:
+      return "kBvOr";
+    case Kind::BITVECTOR_XOR:
+      return "kBvXor";
+    case Kind::BITVECTOR_ADD:
+      return "kBvAdd";
+    case Kind::BITVECTOR_MULT:
+      return "kBvMul";
+    case Kind::BITVECTOR_NAND:
+      return "kBvNand";
+    case Kind::BITVECTOR_NOR:
+      return "kBvNor";
+    case Kind::BITVECTOR_XNOR:
+      return "kBvXnor";
+    case Kind::BITVECTOR_SUB:
+      return "kBvSub";
+    case Kind::BITVECTOR_UDIV:
+      return "kBvUdiv";
+    case Kind::BITVECTOR_UREM:
+      return "kBvUrem";
+    case Kind::BITVECTOR_SDIV:
+      return "kBvSdiv";
+    case Kind::BITVECTOR_SREM:
+      return "kBvSrem";
+    case Kind::BITVECTOR_SMOD:
+      return "kBvSmod";
+    case Kind::BITVECTOR_SHL:
+      return "kBvShl";
+    case Kind::BITVECTOR_LSHR:
+      return "kBvLshr";
+    case Kind::BITVECTOR_ASHR:
+      return "kBvAshr";
+    case Kind::BITVECTOR_COMP:
+      return "kBvComp";
+    case Kind::BITVECTOR_ULT:
+      return "kBvUlt";
+    case Kind::BITVECTOR_ULE:
+      return "kBvUle";
+    case Kind::BITVECTOR_UGT:
+      return "kBvUgt";
+    case Kind::BITVECTOR_UGE:
+      return "kBvUge";
+    case Kind::BITVECTOR_SLT:
+      return "kBvSlt";
+    case Kind::BITVECTOR_SLE:
+      return "kBvSle";
+    case Kind::BITVECTOR_SGT:
+      return "kBvSgt";
+    case Kind::BITVECTOR_SGE:
+      return "kBvSge";
+    case Kind::BITVECTOR_NEGO:
+      return "kBvNego";
+    case Kind::BITVECTOR_UADDO:
+      return "kBvUaddo";
+    case Kind::BITVECTOR_SADDO:
+      return "kBvSaddo";
+    case Kind::BITVECTOR_UMULO:
+      return "kBvUmulo";
+    case Kind::BITVECTOR_SMULO:
+      return "kBvSmulo";
+    case Kind::BITVECTOR_USUBO:
+      return "kBvUsubo";
+    case Kind::BITVECTOR_SSUBO:
+      return "kBvSsubo";
+    case Kind::BITVECTOR_SDIVO:
+      return "kBvSdivo";
+    case Kind::BITVECTOR_CONCAT:
+      return "kBvConcat";
+    case Kind::BITVECTOR_EXTRACT:
+      return "kBvExtract";
+    case Kind::BITVECTOR_REPEAT:
+      return "kBvRepeat";
+    case Kind::BITVECTOR_ZERO_EXTEND:
+      return "kBvZeroExtend";
+    case Kind::BITVECTOR_SIGN_EXTEND:
+      return "kBvSignExtend";
+    case Kind::BITVECTOR_ROTATE_LEFT:
+      return "kBvRotateLeft";
+    case Kind::BITVECTOR_ROTATE_RIGHT:
+      return "kBvRotateRight";
+    default:
+      std::ostringstream message;
+      message << "Unsupported term operator " << kind;
+      throw Unsupported(message.str());
+  }
+}
+
+bool IsIndexed(Kind kind) {
+  switch (kind) {
+    case Kind::BITVECTOR_EXTRACT:
+    case Kind::BITVECTOR_REPEAT:
+    case Kind::BITVECTOR_ZERO_EXTEND:
+    case Kind::BITVECTOR_SIGN_EXTEND:
+    case Kind::BITVECTOR_ROTATE_LEFT:
+    case Kind::BITVECTOR_ROTATE_RIGHT:
+      return true;
+    default:
+      return false;
+  }
+}
+
+struct Definition {
+  const char* factory;
+  Index width;
+  Index edge_begin;
+  Index edge_count;
+  Index payload_begin;
+  Index payload_size;
+  Index depth;
+  Index uses = 0;
+};
+
+struct Frame {
+  Term term;
+  std::size_t child_count;
+  std::size_t first;
+  std::size_t next = 0;
+};
+
+class Graph {
+ public:
+  void AddRoots(const std::vector<Term>& roots) {
+    for (const auto& root : roots) {
+      const auto id = Visit(root);
+      roots_.push_back(id);
+      AddUse(id);
+    }
+  }
+
+  std::size_t Emit(const char* path) {
+    std::vector<char> buffer(1024 * 1024);
+    std::ofstream out;
+    out.exceptions(std::ios::badbit | std::ios::failbit);
+    out.rdbuf()->pubsetbuf(buffer.data(),
+                           static_cast<std::streamsize>(buffer.size()));
+    out.open(path, std::ios::binary);
+    out << "dandelion-node 1 graph\nsort 1 bool\n";
+    for (const Index width : widths_) {
+      out << "sort " << SortId(width) << " bv " << width << '\n';
+    }
+    for (const auto id : declarations_) {
+      const auto decl_id = std::uint64_t{id} + 1;
+      out << "decl " << decl_id << " function "
+          << SortId(definitions_[id].width) << "\ninst " << decl_id << ' '
+          << decl_id << '\n';
+    }
+
+    std::vector<Index> slots(definitions_.size());
+    std::vector<Index> free_slots;
+    std::vector<Index> root_slots;
+    root_slots.reserve(roots_.size());
+    std::size_t slot_count = 0;
+    const auto reserve = [&]() {
+      if (free_slots.empty()) return CheckedIndex(slot_count++);
+      const auto slot = free_slots.back();
+      free_slots.pop_back();
+      return slot;
+    };
+    const auto release = [&](Index node) {
+      if (--definitions_[node].uses == 0) {
+        const auto slot = slots[node];
+        out << "drop " << slot << '\n';
+        free_slots.push_back(slot);
+      }
+    };
+
+    for (std::size_t index = 0; index < definitions_.size(); ++index) {
+      auto& node = definitions_[index];
+      const auto slot = slots[index] = reserve();
+      const auto end = std::size_t{node.edge_begin} + node.edge_count;
+      out << "make " << slot << ' ' << SortId(node.width) << ' ' << node.factory
+          << ' ' << node.edge_count;
+      for (std::size_t edge = node.edge_begin; edge < end; ++edge) {
+        out << ' ' << slots[edges_[edge]];
+      }
+      if (node.payload_size) {
+        out.write(payload_.data() + node.payload_begin, node.payload_size);
+      }
+      out << '\n';
+      for (std::size_t edge = node.edge_begin; edge < end; ++edge) {
+        release(edges_[edge]);
+      }
+    }
+    for (const auto root : roots_) {
+      const auto slot = reserve();
+      root_slots.push_back(slot);
+      out << "hold " << slot << ' ' << slots[root] << '\n';
+      release(root);
+    }
+    out << "roots";
+    for (const auto slot : root_slots) out << ' ' << slot;
+    out << "\nend\n";
+    out.close();
+    return slot_count;
+  }
+
+  void PrintShape(std::ostream& out) const {
+    out << "\"nodes\":" << definitions_.size()
+        << ",\"requests\":" << definitions_.size()
+        << ",\"edges\":" << edges_.size() << ",\"roots\":" << roots_.size()
+        << ",\"depth\":" << depth_ << ",\"max_fanout\":" << max_fanout_
+        << ",\"operations\":" << (2 * definitions_.size() + roots_.size())
+        << ",\"distinct_bv_widths\":" << widths_.size()
+        << ",\"max_bv_width\":" << (widths_.empty() ? 0 : *widths_.rbegin())
+        << ",\"declarations\":" << declarations_.size();
+  }
+
+ private:
+  static std::uint64_t SortId(Index width) { return std::uint64_t{width} + 1; }
+
+  void AddUse(Index node) {
+    auto& uses = definitions_[node].uses;
+    if (uses == std::numeric_limits<Index>::max())
+      throw TooLarge("Snapshot operand use count exceeds the index space");
+    ++uses;
+  }
+
+  Index Visit(const Term& root) {
+    const auto found = ids_.find(root.getId());
+    if (found != ids_.end()) return found->second;
+    stack_.push_back({root, root.getNumChildren(), arguments_.size()});
+    Index result = 0;
+    while (!stack_.empty()) {
+      auto& frame = stack_.back();
+      if (frame.next < frame.child_count) {
+        Term child = frame.term[frame.next++];
+        const auto known = ids_.find(child.getId());
+        if (known != ids_.end()) {
+          arguments_.push_back(known->second);
+        } else {
+          const auto count = child.getNumChildren();
+          stack_.push_back({std::move(child), count, arguments_.size()});
+        }
+      } else {
+        result = Finish(frame);
+        arguments_.resize(frame.first);
+        stack_.pop_back();
+        if (!stack_.empty()) arguments_.push_back(result);
+      }
+    }
+    return result;
+  }
+
+  Index Finish(const Frame& frame) {
+    const auto& term = frame.term;
+    const auto kind = term.getKind();
+    const char* factory = Factory(kind);
+    const auto sort = term.getSort();
+    const bool bv = sort.isBitVector();
+    if (!bv && !sort.isBoolean())
+      throw Unsupported("Expected a Bool or BV sort");
+    if (kind == Kind::BITVECTOR_CONCAT && frame.child_count != 2)
+      throw Unsupported("N-ary concat does not match a single binary factory");
+    const auto width = bv ? sort.getBitVectorSize() : Index{0};
+    if (bv) widths_.insert(width);
+    const auto id = CheckedIndex(definitions_.size());
+    const auto payload_begin = CheckedIndex(payload_.size());
+    if (kind == Kind::CONSTANT) {
+      declarations_.push_back(id);
+      payload_ += ' ' + std::to_string(std::uint64_t{id} + 1);
+    } else if (kind == Kind::CONST_BOOLEAN) {
+      payload_ += term.getBooleanValue() ? " 1" : " 0";
+    } else if (kind == Kind::CONST_BITVECTOR) {
+      payload_ += ' ' + term.getBitVectorValue(10);
+    } else if (IsIndexed(kind)) {
+      auto op = term.getOp();
+      for (std::size_t i = 0, n = op.getNumIndices(); i < n; ++i) {
+        payload_ += ' ' + op[i].getIntegerValue();
+      }
+    }
+    Index depth = 1;
+    const auto edge_begin = CheckedIndex(edges_.size());
+    for (std::size_t edge = frame.first; edge < arguments_.size(); ++edge) {
+      const auto child = arguments_[edge];
+      edges_.push_back(child);
+      AddUse(child);
+      depth =
+          std::max(depth, static_cast<Index>(1 + definitions_[child].depth));
+    }
+    const auto count = CheckedIndex(frame.child_count);
+    max_fanout_ = std::max(max_fanout_, count);
+    depth_ = std::max(depth_, depth);
+    definitions_.push_back({factory, width, edge_begin, count, payload_begin,
+                            CheckedIndex(payload_.size() - payload_begin),
+                            depth});
+    ids_.emplace(term.getId(), id);
+    return id;
+  }
+
+  std::unordered_map<std::uint64_t, Index> ids_;
+  std::vector<Definition> definitions_;
+  std::vector<Index> edges_;
+  std::vector<Index> roots_;
+  std::vector<Index> declarations_;
+  std::set<Index> widths_;
+  std::string payload_;
+  std::vector<Frame> stack_;
+  std::vector<Index> arguments_;
+  Index depth_ = 0;
+  Index max_fanout_ = 0;
+};
+
+void Capture(const char* source, const char* destination) {
+  cvc5::TermManager manager;
+  cvc5::Solver solver(manager);
+  solver.setOption("incremental", "false");
+  cvc5::parser::SymbolManager symbols(manager);
+  cvc5::parser::InputParser parser(&solver, &symbols);
+  const auto open_start = Clock::now();
+  parser.setFileInput(cvc5::modes::InputLanguage::SMT_LIB_2_6, source);
+  const auto open_time = Clock::now() - open_start;
+
+  const std::set<std::string> supported{"set-logic",   "set-info",
+                                        "declare-fun", "declare-const",
+                                        "define-fun",  "assert"};
+  bool query = false;
+  bool exit_seen = false;
+  std::size_t parser_calls = 0;
+  std::size_t assertion_commands = 0;
+  std::size_t definition_commands = 0;
+  Clock::duration parser_time = {};
+  Clock::duration command_time = {};
+  for (;;) {
+    const auto parse_start = Clock::now();
+    auto command = parser.nextCommand();
+    parser_time += Clock::now() - parse_start;
+    ++parser_calls;
+    if (command.isNull()) break;
+    const auto name = command.getCommandName();
+    if (name == "exit" && query && !exit_seen) {
+      exit_seen = true;
+    } else if (name == "check-sat" && !query && !exit_seen) {
+      query = true;
+    } else if (!query && !exit_seen && supported.count(name)) {
+      if (name == "assert") ++assertion_commands;
+      if (name == "define-fun") ++definition_commands;
+      std::ostringstream result;
+      const auto command_start = Clock::now();
+      command.invoke(&solver, &symbols, result);
+      command_time += Clock::now() - command_start;
+      if (!result.str().empty()) throw std::runtime_error(result.str());
+    } else {
+      throw Unsupported("Unexpected command " + name);
+    }
+  }
+  if (!query) throw Empty("Input has no single check-sat");
+  if (assertion_commands == 0) throw Empty("Input has no assertion commands");
+  const auto roots = solver.getAssertions();
+  if (roots.size() < assertion_commands ||
+      roots.size() - assertion_commands > definition_commands) {
+    throw Unsupported("Unexpected number of assertion-list roots");
+  }
+  const auto definition_roots = roots.size() - assertion_commands;
+  std::cerr << "Captured " << roots.size() << " ordered assertion roots\n";
+
+  Graph graph;
+  const auto walk_start = Clock::now();
+  graph.AddRoots(roots);
+  const auto walk_time = Clock::now() - walk_start;
+  std::cerr << "Reachable graph analysis complete\n";
+  const auto output_start = Clock::now();
+  const auto peak = graph.Emit(destination);
+  const auto output_time = Clock::now() - output_start;
+
+  std::cout << '{';
+  graph.PrintShape(std::cout);
+  std::cout << ",\"peak_slots\":" << peak
+            << ",\"parser_calls\":" << parser_calls
+            << ",\"input_open_wall_s\":" << Seconds(open_time)
+            << ",\"parser_wall_s\":" << Seconds(parser_time)
+            << ",\"command_wall_s\":" << Seconds(command_time)
+            << ",\"assertion_commands\":" << assertion_commands
+            << ",\"definition_commands\":" << definition_commands
+            << ",\"definition_roots\":" << definition_roots
+            << ",\"snapshot_wall_s\":" << Seconds(walk_time)
+            << ",\"emit_wall_s\":" << Seconds(output_time) << "}\n";
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  if (argc != 3) {
+    std::cerr << "Usage: dandelion_snapshot SAFE_INPUT.smt2 OUTPUT.node\n";
+    return 4;
+  }
+  try {
+    Capture(argv[1], argv[2]);
+  } catch (const Empty& error) {
+    std::cerr << error.what() << '\n';
+    return 2;
+  } catch (const Unsupported& error) {
+    std::cerr << error.what() << '\n';
+    return 3;
+  } catch (const TooLarge& error) {
+    std::cerr << error.what() << '\n';
+    return 5;
+  } catch (const std::bad_alloc& error) {
+    std::cerr << error.what() << '\n';
+    return 5;
+  } catch (const std::exception& error) {
+    std::cerr << error.what() << '\n';
+    return 4;
+  }
+}
