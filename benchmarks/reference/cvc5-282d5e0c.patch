+thread_local const char* phase = "setup";
+
+struct Output
+{
+  FILE* file = nullptr;
+  const NodeManager* manager = nullptr;
+  uint64_t cap = 0;
+  uint64_t bytes = 0;
+  uint64_t events = 0;
+  const char* failure = nullptr;
+
+  Output()
+  {
+    const char* path = std::getenv("DANDELION_CVC5_TRACE");
+    if (!path) return;
+    const char* limit = std::getenv("DANDELION_CVC5_TRACE_BYTES");
+    cap = limit ? std::strtoull(limit, nullptr, 10) : 134217728;
+    file = std::fopen(path, "wb");
+    if (!file) return;
+    bytes = std::fwrite("dandelion-cvc5 1\n", 1, 17, file);
+  }
+
+  ~Output()
+  {
+    if (!file) return;
+    if (failure) std::fprintf(file, "truncated %s\n", failure);
+    else std::fprintf(file, "end %llu\n", static_cast<unsigned long long>(events));
+    std::fclose(file);
+  }
+
+  bool select(const NodeManager* candidate)
+  {
+    if (!file || failure) return false;
+    if (!manager) manager = candidate;
+    if (manager != candidate)
+    {
+      failure = "multiple-node-managers";
+      return false;
+    }
+    return true;
+  }
+
+  void write(const char* event, std::string_view fields)
+  {
+    if (!file || failure) return;
+    const uint64_t size = std::strlen(event) + std::strlen(phase) + fields.size() + 3;
+    if (bytes + size > cap)
+    {
+      failure = "byte-limit";
+      return;
+    }
+    if (std::fprintf(file, "%s %s %.*s\n", event, phase,
+                     static_cast<int>(fields.size()), fields.data()) < 0)
+    {
+      failure = "write-error";
+      return;
+    }
+    bytes += size;
+    ++events;
+  }
+};
+
+Output& GetOutput()
+{
+  static Output output;
+  return output;
+}
+
+void Format(std::ostream& out, const FloatingPointSize& size)
+{
+  out << ' ' << size.exponentWidth() << ' ' << size.significandWidth();
+}
+
+void Payload(std::ostream& out, const expr::NodeValue* node)
+{
+  switch (node->getKind())
+  {
+    case Kind::BITVECTOR_TYPE:
+      out << ' ' << uint32_t(node->getConst<BitVectorSize>());
+      break;
+    case Kind::FLOATINGPOINT_TYPE:
+      Format(out, node->getConst<FloatingPointSize>());
+      break;
+    case Kind::CONST_BOOLEAN:
+      out << ' ' << node->getConst<bool>();
+      break;
+    case Kind::CONST_INTEGER:
+    case Kind::CONST_RATIONAL:
+      out << ' ' << node->getConst<Rational>().toString();
+      break;
+    case Kind::CONST_BITVECTOR:
+    {
+      const auto& value = node->getConst<BitVector>();
+      out << ' ' << value.getSize() << ' ' << value.toString(10);
+      break;
+    }
+    case Kind::CONST_FLOATINGPOINT:
+    {
+      const auto& value = node->getConst<FloatingPoint>();
+      Format(out, value.getSize());
+      out << ' ' << (value.isNaN() ? "nan" : value.pack().toString(10));
+      break;
+    }
+    case Kind::CONST_ROUNDINGMODE:
+    {
+      const auto mode = node->getConst<RoundingMode>();
+      const auto ordinal = mode == RoundingMode::ROUND_NEAREST_TIES_TO_EVEN ? 0
+          : mode == RoundingMode::ROUND_NEAREST_TIES_TO_AWAY ? 1
+          : mode == RoundingMode::ROUND_TOWARD_POSITIVE ? 2
+          : mode == RoundingMode::ROUND_TOWARD_NEGATIVE ? 3 : 4;
+      out << ' ' << ordinal;
+      break;
+    }
+    case Kind::BITVECTOR_EXTRACT_OP:
+    {
+      const auto& value = node->getConst<BitVectorExtract>();
+      out << ' ' << value.d_high << ' ' << value.d_low;
+      break;
+    }
+    case Kind::BITVECTOR_REPEAT_OP:
+      out << ' ' << uint32_t(node->getConst<BitVectorRepeat>());
+      break;
+    case Kind::BITVECTOR_ZERO_EXTEND_OP:
+      out << ' ' << uint32_t(node->getConst<BitVectorZeroExtend>());
+      break;
+    case Kind::BITVECTOR_SIGN_EXTEND_OP:
+      out << ' ' << uint32_t(node->getConst<BitVectorSignExtend>());
+      break;
+    case Kind::BITVECTOR_ROTATE_LEFT_OP:
+      out << ' ' << uint32_t(node->getConst<BitVectorRotateLeft>());
+      break;
+    case Kind::BITVECTOR_ROTATE_RIGHT_OP:
+      out << ' ' << uint32_t(node->getConst<BitVectorRotateRight>());
+      break;
+    case Kind::INT_TO_BITVECTOR_OP:
+      out << ' ' << uint32_t(node->getConst<IntToBitVector>());
+      break;
+    case Kind::DIVISIBLE_OP: out << ' ' << node->getConst<Divisible>().k; break;
+    case Kind::FLOATINGPOINT_TO_FP_FROM_IEEE_BV_OP:
+      Format(out, node->getConst<FloatingPointToFPIEEEBitVector>().getSize());
+      break;
+    case Kind::FLOATINGPOINT_TO_FP_FROM_FP_OP:
+      Format(out, node->getConst<FloatingPointToFPFloatingPoint>().getSize());
+      break;
+    case Kind::FLOATINGPOINT_TO_FP_FROM_REAL_OP:
+      Format(out, node->getConst<FloatingPointToFPReal>().getSize());
+      break;
+    case Kind::FLOATINGPOINT_TO_FP_FROM_SBV_OP:
+      Format(out, node->getConst<FloatingPointToFPSignedBitVector>().getSize());
+      break;
+    case Kind::FLOATINGPOINT_TO_FP_FROM_UBV_OP:
+      Format(out, node->getConst<FloatingPointToFPUnsignedBitVector>().getSize());
+      break;
+    case Kind::FLOATINGPOINT_TO_SBV_OP:
+      out << ' ' << uint32_t(node->getConst<FloatingPointToSBV>());
+      break;
+    case Kind::FLOATINGPOINT_TO_UBV_OP:
+      out << ' ' << uint32_t(node->getConst<FloatingPointToUBV>());
+      break;
+    default: break;
+  }
+}
+
+}  // namespace
+
+Phase::Phase(const char* name) : d_previous(phase)
+{
+  if (std::strcmp(name, "rewrite") != 0) phase = name;
+  else if (std::strstr(phase, "rewrite") != nullptr) return;
+  else if (std::strcmp(phase, "parse") == 0) phase = "parse.rewrite";
+  else if (std::strcmp(phase, "solve") == 0) phase = "solve.rewrite";
+  else if (std::strcmp(phase, "preprocess") == 0) phase = "preprocess.rewrite";
+  else if (std::strcmp(phase, "command") == 0) phase = "command.rewrite";
+  else phase = "setup.rewrite";
+}
+
+Phase::~Phase() { phase = d_previous; }
+
+bool Enabled()
+{
+  auto& output = GetOutput();
+  return output.file && !output.failure;
+}
+
+void Request(const expr::NodeValue* node, bool sort, const char* outcome)
+{
+  auto& output = GetOutput();
+  if (!output.select(node->getNodeManager())) return;
+  if (std::strcmp(outcome, "hit") == 0)
+  {
+    output.write(outcome, std::to_string(node->getId()));
+    return;
+  }
+  std::ostringstream fields;
+  fields << (sort ? 's' : 'e') << ' ' << node->getId() << ' ';
+  if (node->getKind() == Kind::TYPE_CONSTANT)
+  {
+    switch (node->getConst<TypeConstant>())
+    {
+      case BOOLEAN_TYPE: fields << "BOOLEAN_TYPE"; break;
+      case INTEGER_TYPE: fields << "INTEGER_TYPE"; break;
+      case ROUNDINGMODE_TYPE: fields << "ROUNDINGMODE_TYPE"; break;
+      case REAL_TYPE: fields << "REAL_TYPE"; break;
+      case STRING_TYPE: fields << "STRING_TYPE"; break;
+      case BUILTIN_OPERATOR_TYPE: fields << "BUILTIN_OPERATOR_TYPE"; break;
+      default: fields << "TYPE_CONSTANT_" << static_cast<unsigned>(node->getConst<TypeConstant>());
+    }
+  }
+  else
+    fields << kind::toString(node->getKind());
+  if (node->getMetaKind() == kind::metakind::PARAMETERIZED)
+    fields << ' ' << node->getOperator()->getId();
+  else
+    fields << " -";
+  if (node->getKind() == Kind::STORE_ALL)
+  {
+    const auto& literal = node->getConst<ArrayStoreAll>();
+    fields << " 1 " << literal.getValue().getId() << ' ' << literal.getType().getId();
+  }
+  else
+  {
+    const auto count = node->getNumChildren();
+    fields << ' ' << count;
+    for (uint32_t i = 0; i < count; ++i)
+      fields << ' ' << node->getChild(i)->getId();
+    Payload(fields, node);
+  }
+  output.write(outcome, fields.str());
+}
+
+void Type(const NodeManager* manager, uint64_t node, uint64_t sort)
+{
+  auto& output = GetOutput();
+  if (output.select(manager))
+    output.write("type", std::to_string(node) + ' ' + std::to_string(sort));
+}
+void SortArity(const NodeManager* manager, uint64_t sort, uint64_t arity)
+{
+  auto& output = GetOutput();
+  if (output.select(manager))
+    output.write("arity", std::to_string(sort) + ' ' + std::to_string(arity));
+}
+void Lifetime(const expr::NodeValue* node, const char* event)
+{
+  auto& output = GetOutput();
+  if (output.select(node->getNodeManager()))
+    output.write(event, std::to_string(node->getId()));
+}
+void Root(const char* role, uint64_t id)
+{
+  if (Enabled()) GetOutput().write("root", std::string(role) + ' ' + std::to_string(id));
+}
+void Snapshot(const char* role)
+{
+  GetOutput().write("snapshot", role);
+}
+void Visit(uint64_t id)
+{
+  if (Enabled()) GetOutput().write("visit", std::to_string(id));
+}
+void Cache(const char* kind, unsigned theory, uint64_t key, uint64_t value)
+{
+  if (Enabled())
+    GetOutput().write("cache", kind + std::to_string(theory) + ' '
+                      + std::to_string(key) + ' '
+                      + (key == value ? "-" : std::to_string(value)));
+}
+void CacheLookup(const char* kind, uint64_t key, bool hit)
+{
+  if (Enabled())
+    GetOutput().write("cache-lookup", std::string(kind) + ' '
+                      + std::to_string(key) + (hit ? " hit" : " miss"));
+}
+void Metadata(const char* event, const std::string& fields)
+{
+  GetOutput().write(event, fields);
+}
+void Command(const std::string& name) { GetOutput().write("command", name); }
+
+}  // namespace cvc5::internal::dandelion_trace
