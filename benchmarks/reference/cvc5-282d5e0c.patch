+class CVC5_EXPORT Phase
+{
+ public:
+  explicit Phase(const char* phase);
+  ~Phase();
+  Phase(const Phase&) = delete;
+  Phase& operator=(const Phase&) = delete;
+ private:
+  const char* d_previous;
+};
+
+bool Enabled();
